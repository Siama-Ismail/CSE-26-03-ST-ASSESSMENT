# Server
PORT=3000

# MongoDB connection string (Atlas or local)
# Example: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/videx
MONGO_URI=mongodb://localhost:27017/videx

# Cloudinary - sign in at https://cloudinary.com, copy from Dashboard
CLOUD_NAME=your-cloud-name
CLOUD_PRESET=your-unsigned-upload-preset