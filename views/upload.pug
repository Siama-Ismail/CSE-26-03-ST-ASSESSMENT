doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="stylesheet" href="/css/style.css")
  body
    header
      .logo Videx
      nav
        a(href="/videos") My Videos
        a(href="/upload") Upload
        a(href="/") Home

    .upload-container
      h1 Upload Your Video
      
      form#uploadForm
        // Success message (will be shown by JavaScript)
        .success-message

        // Title Field
        .form-group
          label(for="title") Video Title *
          input#title(type="text" name="title" placeholder="Enter a catchy title for your video" required)
          .error-message

        // Description Field
        .form-group
          label(for="description") Description *
          textarea#description(name="description" placeholder="Describe what your video is about..." required)
          .error-message

        // Quality Selection
        .form-group
          label(for="quality") Video Quality *
          select#quality(name="quality" required)
            option(value="") Select Quality
            option(value="360p") 360p - Standard Definition
            option(value="720p") 720p - HD
            option(value="1080p") 1080p - Full HD
          .error-message

        // Category Field
        .form-group
          label(for="category") Category *
          input#category(type="text" name="category" placeholder="e.g., Gaming, Music, Education, Sports..." required)
          .error-message

        // Tags Field
        .form-group
          label(for="tags") Tags *
          input#tags(type="text" name="tags" placeholder="e.g., gaming, funny, tutorial (comma separated)" required)
          .error-message

        // Video Upload Area
        .form-group
          label Video File *
          #videoUploadArea.file-upload-area
            .file-upload-icon 📹
            .file-upload-text
              strong Click to upload or drag and drop
              | MP4, MPEG, MOV, or AVI (Max 500MB)
            input#videoInput(type="file" name="video" accept="video/*" required)
            .preview-area
          .error-message

        // Thumbnail Upload Area
        .form-group
          label Thumbnail Image *
          #thumbnailUploadArea.file-upload-area
            .file-upload-icon 
            .file-upload-text
              strong Click to upload or drag and drop
              | JPEG, PNG, or GIF (Max 500MB)
            input#thumbnailInput(type="file" name="thumbnail" accept="image/*" required)
            .preview-area
          .error-message

        // Form Buttons
        .form-buttons
          button#submitBtn.btn-submit(type="button") Upload Video
          button#resetBtn.btn-reset(type="button") Reset

    script(src="/js/script.js")
